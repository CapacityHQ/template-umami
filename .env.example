# The local Postgres that Capacity Desktop starts for this project
# (.capacity/compose.services.yaml). A deploy from Capacity sets its own
# DATABASE_URL, pointing at the managed Postgres on your server.
DATABASE_URL=postgresql://umami:umami@localhost:5432/umami

# Signs sessions and share links. Umami derives one from DATABASE_URL when
# this is empty, and a deploy from Capacity sets a random one.
# required: false
APP_SECRET=

# Enables two-factor authentication once set to 64 hex characters
# (generate one with `openssl rand -hex 32`). Optional.
# required: false
TWO_FACTOR_ENCRYPTION_KEY=
